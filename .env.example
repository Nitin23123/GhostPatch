# Copy this file to .env and fill in a key. .env is gitignored and never shared.

# Which provider to use: gemini (free), groq (free), ollama (free, local), openai (paid)
GHOSTPATCH_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free key: https://console.groq.com/keys
# GROQ_API_KEY=

# Paid: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional: override the provider's default model
# GHOSTPATCH_MODEL=
