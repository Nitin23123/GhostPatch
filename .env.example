# Copy this file to .env and fill in a key, or run `ghostpatch init` to save your keys once for
# every project. .env is gitignored and never shared.

# Which provider to use: groq, openrouter, gemini (all free), ollama (free, local), openai (paid)
GHOSTPATCH_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Free backups, used automatically when the main provider's daily quota runs out:
# https://openrouter.ai/keys (use models ending in ":free")
# OPENROUTER_API_KEY=
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Paid: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional: override the provider's default model
# GHOSTPATCH_MODEL=

# Optional: the fallback order ("none" turns fallback off)
# GHOSTPATCH_FALLBACK=openrouter,gemini
